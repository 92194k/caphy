{
  "version": 1,
  "notes": "Phrases must use words that exist in the Vosk model lexicon for that language. Keep this file as the single source of truth for voice phrases - do not hardcode phrases in voice_commands.py. Each intent 'id' matches a method name on the controller object in app.py.",
  "fallback": {
    "unrecognized": {
      "en": "Sorry, I did not understand that command.",
      "tl": "Pasensya, hindi ko naintindihan ang utos."
    },
    "system_error": {
      "en": "Something went wrong running that command.",
      "tl": "May problema sa pagpatakbo ng utos."
    }
  },
